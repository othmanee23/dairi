# Copy to .env.local and use the local values printed by `npx supabase status`
VITE_SUPABASE_URL=http://127.0.0.1:54321
VITE_SUPABASE_PUBLISHABLE_KEY=replace-with-local-anon-key
# Set to the approved public HTTPS domain for the production build. Leave blank for local and staging previews.
VITE_PUBLIC_SITE_URL=
